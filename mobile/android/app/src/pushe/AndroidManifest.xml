<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <meta-data android:name="pushe_token" android:value="${pusheToken}" />
        <!-- Pushe brings its own FCM courier; the Flutter FCM service must not
             compete for the same MESSAGING_EVENT intent in these builds. -->
        <service
            android:name="io.flutter.plugins.firebase.messaging.FlutterFirebaseMessagingService"
            tools:node="remove" />
    </application>
</manifest>

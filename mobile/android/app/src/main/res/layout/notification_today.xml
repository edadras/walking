<?xml version="1.0" encoding="utf-8"?>
<!-- Lock-screen "today" notification body (collapsed view): steps, goal progress, streak/pending. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/n_steps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/n_goal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="@android:style/TextAppearance.Material.Notification" />

        <TextView
            android:id="@+id/n_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFB07A00"
            android:textSize="13sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/n_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progressDrawable="@android:drawable/progress_horizontal"
        android:progressTint="#FF1A7F4B"
        android:progressBackgroundTint="#FFE6F2EB" />

    <TextView
        android:id="@+id/n_pending"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#FF1A7F4B"
        android:textSize="12sp" />
</LinearLayout>
